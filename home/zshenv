# zshを起動したときに必ず読み込まれるファイル
# 非インタラクティブシェル（シェルスクリプト実行など）でも読み込まれる
# 基本的に環境変数以外はここに書かない

export XDG_CONFIG_HOME="$HOME"/.config
export XDG_CACHE_HOME="$HOME"/.cache
export XDG_DATA_HOME="$HOME"/.local/share
export XDG_STATE_HOME="$HOME"/.local/state

# Dotfiles管理
# ~/.zshenv は home/zshenv への symlink。自身の symlink 先からリポジトリルートを解決する
# （リポジトリを移動しても追従する）。DOTFILES_DIR で上書き可能。
export DOTFILES_DIR="${DOTFILES_DIR:-${${(%):-%x}:A:h:h}}"
export DOTFILES_HANGER_DIR="$DOTFILES_DIR/hanger"

export EDITOR="micro"
# https://github.com/yyx990803/launch-editor
export LAUNCH_EDITOR="code"

