[user]
	name = elecdeer
	email = 37701077+elecdeer@users.noreply.github.com
  signingkey = ~/.ssh/id_git_sign
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	autocrlf = input
	quotepath = false
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-sign

[i18n]
	logOutputEncoding = utf-8
	commitEncoding = utf-8

[commit]
	gpgsign = true
[push]
  autoSetupRemote = true
[fetch]
	prune = true
[pull]
  ff = only
	rebase = false
[rebase]
	autoStash = true
	autoSquash = true

[merge]
	conflictStyle = diff3
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[filter "jsonsort"]
	; 外部ツールが整形・配列順・model/effortLevelを書き換えても差分が出ないよう index 側を正規化する
	clean = jq -S 'walk(if type==\"array\" then sort else . end) | del(.model, .effortLevel)'


[url "https://github.com/"]
	insteadOf = git@github.com:
[credential "https://github.com"]
  helper = !gh auth git-credential
[credential "https://gist.github.com"]
  helper = !gh auth git-credential

[gdn]
	root = ~/dev
	defaultHost = github.com
	wtBasedir = "../{gitroot}.wt"
	postCloneHook = gdn-post-clone
