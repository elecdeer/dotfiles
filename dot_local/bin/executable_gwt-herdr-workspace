#!/usr/bin/env zsh

setopt local_options
unsetopt xtrace

herdr_bin="${HERDR_BIN_PATH:-herdr}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
source_dir="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
gwt_plugin_dir="${GWT_PLUGIN_DIR:-$source_dir/hanger/plugins/gwt}"

function _gwt_herdr_pane_id() {
  local workspace_id="$1"
  [[ -z "$workspace_id" ]] && return 1
  "$herdr_bin" pane list --workspace "$workspace_id" 2>/dev/null | jq -r '.result.panes[0].pane_id // empty' 2>/dev/null
}

function _gwt_herdr_split_workspace() {
  local workspace_id="$1"
  local pane_cwd="$2"
  local pane_id
  pane_id=$(_gwt_herdr_pane_id "$workspace_id")
  [[ -z "$pane_id" ]] && return 1
  "$herdr_bin" pane split "$pane_id" --direction right --ratio 0.5 --cwd "$pane_cwd" --no-focus >/dev/null 2>&1
}

function _gwt_herdr_run_enter() {
  local workspace_id="$1"
  local worktree_name="$2"
  local selected_path="$3"
  local pane_id command
  pane_id=$(_gwt_herdr_pane_id "$workspace_id")
  [[ -z "$pane_id" ]] && return 1
  command="GWT_PLUGIN_DIR=${(q)gwt_plugin_dir} source ${(q)gwt_plugin_dir}/executable_gwt-enter ${(q)worktree_name} ${(q)selected_path}"
  "$herdr_bin" pane run "$pane_id" "$command"
}

selected_line=$("$gwt_plugin_dir/executable_gwt-select" "$cwd") || exit 130
[[ -z "$selected_line" ]] && exit 130

worktree_name=$(printf '%s' "$selected_line" | head -1 | cut -f1)
selected_path=$(printf '%s' "$selected_line" | head -1 | cut -f2)
[[ -z "$worktree_name" ]] && exit 1

existing_workspace_id=$("$herdr_bin" workspace list 2>/dev/null | jq -r --arg label "$worktree_name" '.result.workspaces[] | select(.label == $label) | .workspace_id' 2>/dev/null | head -1)
if [[ -n "$existing_workspace_id" ]]; then
  "$herdr_bin" workspace focus "$existing_workspace_id"
  exit
fi

workspace_cwd="$cwd"
if [[ -n "$selected_path" && "$selected_path" != __BASE__:* ]]; then
  workspace_cwd="$selected_path"
fi

new_workspace_id=$("$herdr_bin" workspace create --cwd "$workspace_cwd" --label "$worktree_name" --focus 2>/dev/null | jq -r '(.result.workspace.workspace_id // .result.workspace_id // .result.created_workspace.workspace_id // .workspace_id // .id // empty)' 2>/dev/null)
[[ -z "$new_workspace_id" ]] && exit 1

if [[ -z "$selected_path" || "$selected_path" == __BASE__:* ]]; then
  _gwt_herdr_run_enter "$new_workspace_id" "$worktree_name" "$selected_path"
else
  _gwt_herdr_split_workspace "$new_workspace_id" "$workspace_cwd"
fi
