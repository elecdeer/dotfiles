#!/usr/bin/env zsh

setopt local_options
unsetopt xtrace

herdr_bin="${HERDR_BIN_PATH:-herdr}"
cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

workspace_id=$("$herdr_bin" workspace create --cwd "$cwd" --focus 2>/dev/null | jq -r '(.result.workspace.workspace_id // .result.workspace_id // .result.created_workspace.workspace_id // .workspace_id // .id // empty)' 2>/dev/null)
[[ -z "$workspace_id" ]] && exit 1

pane_id=$("$herdr_bin" pane list --workspace "$workspace_id" 2>/dev/null | jq -r '.result.panes[0].pane_id // empty' 2>/dev/null)
[[ -z "$pane_id" ]] && exit 1

"$herdr_bin" pane split "$pane_id" --direction right --ratio 0.5 --cwd "$cwd" --no-focus >/dev/null 2>&1
